# ──────────────────────────────────────────────────────────────
# Save The Day — Local Development Environment
# Copy this file to .env.local and fill in your credentials
# ──────────────────────────────────────────────────────────────

# ── Supabase ───────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Supabase Auth (configure in Supabase dashboard) ────────────
# Dashboard → Authentication → URL Configuration
# Site URL: http://localhost:3000 (dev) or https://yourdomain.com (prod)
# Redirect URLs: http://localhost:3000/auth/callback
# Enable providers: Email (magic link), Google OAuth

# ── App URL ────────────────────────────────────────────────────
# Used for OG images, sharing links, and email notifications
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudinary (optional — for photo uploads) ─────────────────
# Get from: https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email Notifications (optional — for RSVP alerts) ──────────
# Sign up at: https://resend.com (free tier: 100 emails/day)
# When set, the couple receives an email every time a guest RSVPs
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# ── Rate Limiting (recommended for production) ─────────────────
# Sign up at: https://upstash.com (free tier covers most use)
# When set, rate limiting uses Redis across all serverless instances
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Error Monitoring (recommended for production) ─────────────
# Sign up at: https://sentry.io (free tier: 5k errors/month)
# When set, unhandled errors and exceptions are reported to Sentry
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=javascript-nextjs
SENTRY_AUTH_TOKEN=your-sentry-auth-token
